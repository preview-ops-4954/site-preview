# --- Server ---
PORT=3000
# Public base URL (needed for Stripe redirects and ICS links in production)
BASE_URL=http://localhost:3000

# --- Admin ---
# CHANGE THESE before any real deployment
ADMIN_PASSWORD=jwre-dev-password
SESSION_SECRET=dev-secret-change-me

# --- Stripe (TEST MODE keys only for now: https://dashboard.stripe.com/test/apikeys) ---
# Leave blank to run without payments (orders are recorded as "payment pending")
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend free tier: 3,000 emails/mo, https://resend.com/pricing) ---
# Leave blank to log outgoing mail to data/outbox.log instead
# Email is log-only by standing decision - do not set a provider key.
# RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=orders@jwremedia.example

# --- Storage ---
DATA_DIR=./data

# --- Persistence (docs/persistence.md) ---
# json = local data/db.json (default; ephemeral on Render free tier)
# pg   = Supabase Postgres - requires DATABASE_URL and `npm run migrate` once
STORAGE_BACKEND=json
# Supabase: Project Settings -> Database -> Connection string (session pooler)
DATABASE_URL=

# --- Media object storage: Cloudflare R2 (phase 2; disk until switched) ---
MEDIA_BACKEND=disk
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=jwre-media
